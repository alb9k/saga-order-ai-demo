    {
      "name": "02 - PAYMENT errore 422 e conflitto 409",
      "item": [
        {
          "name": "Fallimento simulato -> 422",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{paymentBase}}/internal/payment/{{directPaymentId}}/authorize?fail=true"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"directPaymentId\", pm.variables.replaceIn(\"{$guid}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 422\", () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "Creazione corretta per preparare compensazione -> 200",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{paymentBase}}/internal/payment/{{directPaymentId}}/authorize"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Compensazione -> 200",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{paymentBase}}/internal/payment/{{directPaymentId}}/void"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ripetizione dopo compensazione -> 409",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{paymentBase}}/internal/payment/{{directPaymentId}}/authorize"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verifica stato CANCELLED",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{paymentBase}}/internal/payment/{{directPaymentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const d=pm.response.json();pm.test(\"Stato risorsa CANCELLED\",()=>pm.expect(d.status).to.eql(\"CANCELLED\"));"
                ]
              }
            }
          ]
        }
      ]
